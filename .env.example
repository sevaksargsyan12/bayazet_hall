NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=http://localhost/bayazet-hall/graphql
NEXT_PUBLIC_SITE_URL=https://bayazethall.com

# Resend (contact form notification emails) — https://resend.com/api-keys
RESEND_API_KEY=
# Primary recipient — visible "to" and "reply-to" address (e.g. info@bayazethall.am)
CONTACT_FORM_RECIPIENT=
# Optional silent bcc copy — never shown to the primary recipient
CONTACT_FORM_RECIPIENT2=

# Google Analytics 4 + Microsoft Clarity — both are optional; each tracker
# only loads when its own env var is set, so leaving these blank in local
# dev means no test traffic reaches production analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
